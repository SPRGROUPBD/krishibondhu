{
  "rules": {
    "users": {
      ".read": true,
      ".write": true,
      ".indexOn": ["phone", "role", "district"]
    },
    "categories": {
      ".read": true,
      ".write": true
    },
    "locations": {
      ".read": true,
      ".write": true
    },
    "products": {
      ".read": true,
      ".write": true,
      ".indexOn": ["farmerId", "categoryId", "district", "status"]
    },
    "orders": {
      ".read": true,
      ".write": true,
      ".indexOn": ["buyerId", "farmerId", "status"]
    },
    "notifications": {
      ".read": true,
      ".write": true,
      ".indexOn": ["userId", "targetRole", "createdAt"]
    },
    "reviews": {
      ".read": true,
      ".write": true,
      ".indexOn": ["farmerId", "orderId"]
    },
    "complaints": {
      ".read": true,
      ".write": true
    },
    "auditLogs": {
      ".read": true,
      ".write": true
    },
    "adConfig": {
      ".read": true,
      ".write": true
    }
  }
}
